<!-- {{ ansible_managed }} -->
<!-- ClickHouse listens on the node's own IP and localhost only. The VIP ports
     (8123/9000) belong to HAProxy, which binds them on the floating address. -->
<clickhouse>
    <listen_host>{{ node_ip }}</listen_host>
    <listen_host>127.0.0.1</listen_host>
    <listen_host>::1</listen_host>
    <listen_try>1</listen_try>

    <http_port>{{ ch_http_port }}</http_port>
    <tcp_port>{{ ch_native_port }}</tcp_port>
    <max_connections>4096</max_connections>
    <timezone>UTC</timezone>
</clickhouse>
