<!-- {{ ansible_managed }} -->
<clickhouse>
    <logger>
        <level>information</level>
        <size>500M</size>
        <count>5</count>
    </logger>

    <prometheus>
        <endpoint>/metrics</endpoint>
        <port>{{ ch_prometheus_port }}</port>
        <metrics>true</metrics>
        <events>true</events>
        <asynchronous_metrics>true</asynchronous_metrics>
    </prometheus>
</clickhouse>
