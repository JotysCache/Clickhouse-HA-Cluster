<!-- {{ ansible_managed }} -->
<clickhouse>
    <profiles>
        <app>
            <profile>default</profile>
            <max_execution_time>30</max_execution_time>
            <!-- An INSERT is acknowledged only once {{ app_insert_quorum }} replicas have it,
                 so losing any single node can never lose acknowledged data. -->
            <insert_quorum>{{ app_insert_quorum }}</insert_quorum>
            <insert_quorum_timeout>{{ app_insert_quorum_timeout_ms }}</insert_quorum_timeout>
        </app>
    </profiles>

    <users>
        <!-- Built-in user: localhost only, with a password. -->
        <default>
            <password remove="1"/>
            <password_sha256_hex>{{ vault_default_password | hash('sha256') }}</password_sha256_hex>
            <networks replace="replace">
                <ip>::1</ip>
                <ip>127.0.0.1</ip>
            </networks>
        </default>

        <admin>
            <password_sha256_hex>{{ vault_admin_password | hash('sha256') }}</password_sha256_hex>
            <networks>
                <ip>::1</ip>
                <ip>127.0.0.1</ip>
{% for ip in cluster_node_ips %}
                <ip>{{ ip }}</ip>
{% endfor %}
{% for cidr in admin_cidrs %}
                <ip>{{ cidr }}</ip>
{% endfor %}
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <access_management>1</access_management>
            <named_collection_control>1</named_collection_control>
        </admin>

        <app>
            <password_sha256_hex>{{ vault_app_password | hash('sha256') }}</password_sha256_hex>
            <networks>
                <ip>::1</ip>
                <ip>127.0.0.1</ip>
{% for ip in cluster_node_ips %}
                <ip>{{ ip }}</ip>
{% endfor %}
{% for cidr in client_cidrs %}
                <ip>{{ cidr }}</ip>
{% endfor %}
            </networks>
            <profile>app</profile>
            <quota>default</quota>
            <grants>
                <query>GRANT SELECT, INSERT ON {{ app_database }}.*</query>
                <query>GRANT SELECT ON system.*</query>
            </grants>
        </app>
        <!-- Used only by HAProxy health checks from the cluster nodes. -->
        <{{ healthcheck_user }}>
            <password_sha256_hex>{{ healthcheck_password | hash('sha256') }}</password_sha256_hex>
            <networks>
{% for ip in cluster_node_ips %}
                <ip>{{ ip }}</ip>
{% endfor %}
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <grants>
                <query>GRANT SELECT ON {{ app_database }}.events</query>
            </grants>
        </{{ healthcheck_user }}>
    </users>
</clickhouse>
