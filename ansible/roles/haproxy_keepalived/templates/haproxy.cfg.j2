# {{ ansible_managed }}
global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin
    stats timeout 30s
    user haproxy
    group haproxy
    daemon
    maxconn 20000

defaults
    log     global
    option  dontlognull
    timeout connect 3s
    timeout client  5m
    timeout server  5m
    timeout check   2s
    retries 2
    option  redispatch

# ---- HTTP interface (8123) ---------------------------------------------------
frontend ch_http
    bind {{ vip_address }}:{{ ch_http_port }}
    mode http
    option httplog
    option forwardfor
    # Lets clients see which proxy (= current VIP owner) handled the request.
    http-response set-header X-HAProxy-Node {{ inventory_hostname }}
    default_backend ch_http_nodes

backend ch_http_nodes
    mode http
    balance leastconn
    option httpchk
    http-check send meth GET uri /?query={{ healthcheck_query | urlencode }} hdr Authorization "Basic {{ (healthcheck_user ~ ':' ~ healthcheck_password) | b64encode }}"
    http-check expect status 200
    http-response set-header X-CH-Backend %[srv_name]
    # Mark a node down after 2 failed checks (~4s) and kill its open sessions so
    # clients reconnect to a healthy node instead of hanging.
    default-server inter 2s fall 2 rise 3 on-marked-down shutdown-sessions
{% for h in groups['clickhouse'] %}
    server {{ h }} {{ hostvars[h].node_ip }}:{{ ch_http_port }} check
{% endfor %}

# ---- Native TCP interface (9000) ---------------------------------------------
frontend ch_native
    bind {{ vip_address }}:{{ ch_native_port }}
    mode tcp
    option tcplog
    default_backend ch_native_nodes

backend ch_native_nodes
    mode tcp
    balance leastconn
    option httpchk
    http-check send meth GET uri /?query={{ healthcheck_query | urlencode }} hdr Authorization "Basic {{ (healthcheck_user ~ ':' ~ healthcheck_password) | b64encode }}"
    http-check expect status 200
    default-server inter 2s fall 2 rise 3 on-marked-down shutdown-sessions
{% for h in groups['clickhouse'] %}
    server {{ h }} {{ hostvars[h].node_ip }}:{{ ch_native_port }} check port {{ ch_http_port }}
{% endfor %}

# ---- Stats -------------------------------------------------------------------
listen stats
    bind *:{{ haproxy_stats_port }}
    mode http
    stats enable
    stats uri /stats
    stats refresh 5s
    stats show-node {{ inventory_hostname }}
