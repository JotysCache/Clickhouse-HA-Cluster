# {{ ansible_managed }}
# Real client IP from Cloudflare (for logs); only trusted from Cloudflare ranges.
{% for cidr in cloudflare_cidrs %}
set_real_ip_from {{ cidr }};
{% endfor %}
real_ip_header CF-Connecting-IP;

# Anything that isn't our hostname (e.g. scanners hitting the bare IP): drop.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    ssl_reject_handshake on;
    return 444;
}

server {
    listen 80;
    listen [::]:80;
    server_name {{ web_domain }};
    return 301 https://$host$request_uri;
}

server {
    # nginx 1.24 (Ubuntu 24.04): http2 is a listen parameter ("http2 on;" needs >= 1.25.1)
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ web_domain }};

    ssl_certificate     /etc/ssl/chpoc/origin.pem;
    ssl_certificate_key /etc/ssl/chpoc/origin.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'" always;

    auth_basic "ClickHouse HA status";
    auth_basic_user_file /etc/nginx/chpoc.htpasswd;

    location / {
        proxy_pass http://127.0.0.1:{{ web_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
}
