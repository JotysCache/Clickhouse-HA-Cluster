# {{ ansible_managed }}
# Egress proxy for the private ClickHouse nodes. Only the package sources the
# deployment needs are reachable; everything else is denied.
http_port {{ egress_proxy_host }}:{{ egress_proxy_port }}

acl vpc src {{ vpc_cidr }}
acl allowed_sites dstdomain {{ egress_allowed_domains | join(' ') }}
acl SSL_ports port 443
acl Safe_ports port 80 443
acl CONNECT method CONNECT

http_access deny !Safe_ports
http_access deny CONNECT !SSL_ports
http_access allow vpc allowed_sites
http_access deny all

# Small cache: the 3 nodes download the same packages.
cache_mem 128 MB
maximum_object_size 512 MB
refresh_pattern -i \.deb$ 129600 100% 129600
refresh_pattern . 0 20% 4320

access_log daemon:/var/log/squid/access.log squid
forwarded_for delete
via off
